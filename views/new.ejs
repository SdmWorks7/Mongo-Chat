<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add new Chat</title>
</head>
<body>
    <h3>Add new chat</h3>
    <form method="POST" action="/chats">
        <input placeholer="Who are you?" name="from"/><br>
        <textarea name="msg">Write your message here!</textarea><br>
        <input placeholer="Send to?" name="to"/><br>
        <button type="Submit">Send</button>
    </form>
</body>
</html>